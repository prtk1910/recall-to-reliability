# Choose exactly one provider. The default is direct OpenAI.
RELIABMEM_PROVIDER=openai

# Direct OpenAI
OPENAI_API_KEY=replace-with-your-openai-api-key
RELIABMEM_MODEL=gpt-5.6-luna
RELIABMEM_EMBEDDING_MODEL=text-embedding-3-small

# OpenRouter alternative. Uncomment these values and set RELIABMEM_PROVIDER=openrouter.
# OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
# RELIABMEM_MODEL=anthropic/claude-sonnet-4.5
# RELIABMEM_EMBEDDING_MODEL=openai/text-embedding-3-small
# OPENROUTER_SITE_URL=https://github.com/prtk1910/recall-to-reliability
# OPENROUTER_APP_TITLE=Recall-to-Reliability

# Optional reasoning setting.
# RELIABMEM_REASONING_EFFORT=low

# Optional price overrides for custom direct endpoints. OpenRouter prices are discovered
# from its model catalog and charged cost is taken from each response's usage object.
# RELIABMEM_INPUT_PRICE_PER_MILLION=1.00
# RELIABMEM_OUTPUT_PRICE_PER_MILLION=5.00
# RELIABMEM_CACHED_INPUT_PRICE_PER_MILLION=0.50
# RELIABMEM_CACHE_WRITE_PRICE_PER_MILLION=1.00
# RELIABMEM_REQUEST_PRICE_USD=0
